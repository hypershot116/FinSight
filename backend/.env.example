# Database (SQLite for local dev, Neon PostgreSQL URI for production)
DATABASE_URL=sqlite:///./fiscaly.db

# JWT Signing Secret (generate a strong random 32+ char string)
SECRET_KEY=replace-with-a-long-random-secret-key

# Transactional Email (Brevo API)
BREVO_API_KEY=xkeysib-your-brevo-restricted-api-key
BREVO_SENDER_EMAIL=verified-sender@yourdomain.com

# Live Frontend Origin (used to build password reset URLs; no trailing slash)
FRONTEND_URL=http://localhost:5173

# AI Financial Analyst (Groq primary; optional Gemini fallback)
GROQ_API_KEY=gsk_your-groq-api-key
GEMINI_API_KEY=
